{
  "manifest_version": 3,
  "name": "Autonomize — Cognitive Independence Tracker",
  "short_name": "Autonomize",
  "version": "0.5.0",
  "description": "Tracks whether your independent thinking is growing or eroding from AI over-reliance — measured against your own baseline, never a population average. No keystrokes or text content are ever read or stored.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "https://api.autonomize.example/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.google.com/search*"
      ],
      "js": [
        "telemetry.js",
        "site-map.js",
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}