# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is only read locally (see _env.py) — never commit your real one.

# Leave DATABASE_URL unset (or delete this file) to use the zero-setup
# local SQLite backend — nothing else changes, the API is identical.
#
# To connect Supabase instead: create a project at https://supabase.com,
# then Project Settings -> Database -> Connection string -> "URI".
# Use the *pooler* connection string (port 6543, "Transaction" mode) if
# your network/host doesn't support IPv6 or you expect many short-lived
# connections; use the direct connection (port 5432) otherwise.
#
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Which Postgres schema the tables live in. Defaults to `public`, which is
# right for a database that belongs to this project alone.
#
# Set it to `autonomize` when the Supabase project is shared with anything
# else. Two things follow from a dedicated schema, and both matter:
#
#   1. Supabase serves `public` over PostgREST, so a table sitting there is
#      readable with the project's anon key unless row-level security says
#      otherwise. A schema that isn't exposed to the API isn't reachable
#      that way at all — the guarantee holds by construction rather than by
#      remembering to write a policy.
#   2. Removing this app later is one `DROP SCHEMA autonomize CASCADE`,
#      not a list of nine tables someone has to keep in sync.
#
# The backend creates the schema on first run if it doesn't exist, and
# every connection is opened with its search_path already pointing there.
#
# AUTONOMIZE_PG_SCHEMA=autonomize

# Optional, independent of DATABASE_URL above: turns on real per-student
# auth. Leave unset and every request's user_id is trusted as-is (the
# original MVP behavior). Set it and every request must carry a valid
# Supabase-issued bearer token instead — see auth.py and the dashboard's
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (dashboard-app/.env.example).
# Find it in your Supabase project: Project Settings -> API -> JWT Settings
# -> JWT Secret.
#
# SUPABASE_JWT_SECRET=your-project-jwt-secret

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Postgres connection pool bounds (ignored on the SQLite backend). Defaults
# are 1 and 10. Against Supabase, keep the max comfortably under your
# project's connection limit if you run more than one instance of this
# service.
#
# AUTONOMIZE_PG_POOL_MIN=1
# AUTONOMIZE_PG_POOL_MAX=10

# Points the SQLite backend at a specific file instead of
# backend/autonomize.db. Used by the e2e suite so test fixtures never land
# in a real dev database; rarely needed otherwise.
#
# AUTONOMIZE_DB_PATH=./autonomize.db

# Used only by the test suite (backend/tests/conftest.py). When set, the
# database tests additionally run against this Postgres instance, so the
# dual-backend support is verified rather than assumed. Never point this
# at a database you care about — the tests create and drop schemas in it.
#
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Telemetry endpoints require a credential. The extension gets one
# automatically on first run via POST /api/auth/device — no signup, no email,
# no external identity provider. You do not need to set anything here.
#
# AUTONOMIZE_ALLOW_ANONYMOUS_IDS restores the pre-device-account behaviour,
# where any request could name any user_id and be believed. That is an IDOR:
# with it set, anyone can read or delete anyone's data. It exists only so an
# upgrade doesn't orphan history collected under the old scheme. Leave it
# unset unless you are migrating, and never set it on a public URL.
# AUTONOMIZE_ALLOW_ANONYMOUS_IDS=1

# Device sessions have no credential to re-enter, so expiring one would
# silently orphan a student's history rather than prompt a login. Defaults to
# one year.
# AUTONOMIZE_DEVICE_SESSION_TTL=31536000

# Device registration has its own rate limit, separate from the credential
# limiter — it guards no secret, so the only abuse is flooding the users
# table. Per client address, per 5-minute window.
# AUTONOMIZE_DEVICE_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# PRODUCTION — the two that break a deployment if left unset
# ---------------------------------------------------------------------------

# Signing key for this backend's own session tokens.
#
# LEAVE UNSET AND THE BACKEND GENERATES A RANDOM ONE PER PROCESS. That is
# the correct default for local development — the alternative is a
# hard-coded key in a public repo, which is a total authentication bypass
# for anyone who deploys it as-is. But in production it means:
#
#   - every restart or redeploy signs every student out;
#   - two replicas issue tokens the other rejects.
#
# /api/auth/config reports `ephemeral_secret: true` when this is unset, so
# a deployment can check itself. Generate one with:
#
#     openssl rand -base64 48
#
# AUTONOMIZE_AUTH_SECRET=

# Comma-separated origins allowed to call this API from a browser.
#
# DEFAULTS TO "*". Fine locally; on a public URL it is a wildcard CORS
# policy on an authenticated API, and the backend logs a warning at
# startup saying so. Set it to the exact dashboard origin(s):
#
# AUTONOMIZE_ALLOWED_ORIGINS=https://dashboard.example.edu,chrome-extension://YOUR_EXTENSION_ID

# ---------------------------------------------------------------------------
# Rate limiting and logging
# ---------------------------------------------------------------------------

# Global limiter, "requests/seconds" per client address. Unset means off.
# NOTE: the limiter is in-process (see ratelimit.py), so with more than one
# replica each has its own bucket — put a gateway limiter in front if that
# matters.
# AUTONOMIZE_RATE_LIMIT=300/60

# Credential endpoints (login/register) have their own tighter bucket,
# per client address per 5-minute window. Defaults to 20.
# AUTONOMIZE_AUTH_RATE_LIMIT=20

# How long a password-account session lasts, in seconds. Defaults to 30 days.
# Device sessions use AUTONOMIZE_DEVICE_SESSION_TTL above instead.
# AUTONOMIZE_SESSION_TTL=2592000

# DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
# AUTONOMIZE_LOG_LEVEL=INFO

# Alias for DATABASE_URL, read only if DATABASE_URL is unset. Present
# because Supabase's own docs sometimes use this name.
# SUPABASE_DB_URL=

# ===========================================================================
# AUTHENTICATION
#
# Everything below is optional for local development and the service starts
# without any of it. `/api/auth/config` reports what is actually on, and the
# startup log prints one line per subsystem — so "is Google enabled" is
# never a guess.
# ===========================================================================

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------

# Access-token lifetime in seconds. Default 600 (10 minutes).
#
# This is the number that bounds the damage of a leaked access token, and
# every increase trades directly against that. It is only usable because
# refresh tokens rotate — see tokens.py.
# AUTONOMIZE_ACCESS_TTL=600

# Refresh-token lifetime in seconds. Default 2592000 (30 days).
#
# Long on purpose: rotation means a live client keeps renewing, so only an
# ABANDONED token ever reaches this. It doubles as "sign out after 30 days
# of not opening the app".
# AUTONOMIZE_REFRESH_TTL=2592000

# ---------------------------------------------------------------------------
# Cookies and CSRF
# ---------------------------------------------------------------------------

# Set to 1 in production. Turns on Secure cookies and the `__Host-` cookie
# prefix, which is a browser-enforced guarantee that no subdomain can
# overwrite the session cookie — the defence against session fixation from
# an XSS on any other subdomain.
#
# Off by default because Secure cookies are simply not sent over plain
# http, so leaving it on would break local development silently.
# AUTONOMIZE_SECURE_COOKIES=1

# lax (default), strict, or none.
#
# `lax` blocks the cross-site POST that CSRF needs while still letting a
# link from an email arrive signed in. `strict` logs users out when they
# follow such a link. `none` sends the cookie on every cross-site request
# and gives the defence away — do not.
# AUTONOMIZE_COOKIE_SAMESITE=lax

# NOTE: cookie authentication requires AUTONOMIZE_ALLOWED_ORIGINS to be an
# explicit list. The service REFUSES TO START with a wildcard plus
# credentials, because FastAPI's response to that combination is to reflect
# the caller's origin — i.e. to trust every origin — which is the opposite
# of what writing "*" suggests.

# ---------------------------------------------------------------------------
# Email — required for OTP sign-in, email verification and password reset
# ---------------------------------------------------------------------------

# WITHOUT AUTONOMIZE_SMTP_HOST NO MAIL IS SENT. Codes go to the server log
# (and to AUTONOMIZE_MAIL_DIR if set) and `/api/auth/config` reports
# `"mail_mode": "console"`. That is a supported way to develop and an
# unsupported way to run — every account whose owner is waiting for a code
# is locked out. The startup log says so in capitals.
#
# AUTONOMIZE_SMTP_HOST=smtp.sendgrid.net
# AUTONOMIZE_SMTP_PORT=587
# AUTONOMIZE_SMTP_USER=apikey
# AUTONOMIZE_SMTP_PASSWORD=
# AUTONOMIZE_SMTP_STARTTLS=1
# AUTONOMIZE_MAIL_FROM=Autonomize <no-reply@your-college.edu>

# Writes every console-mode message to a file as well as the log. Local
# convenience only; has no effect once SMTP is configured.
# AUTONOMIZE_MAIL_DIR=./.mail

# ---------------------------------------------------------------------------
# One-time codes
# ---------------------------------------------------------------------------

# A six-digit code is a one-in-a-million guess, which is ONLY safe because
# of the attempt cap. Raising AUTONOMIZE_OTP_MAX_ATTEMPTS is the setting
# most likely to quietly break that.
# AUTONOMIZE_OTP_TTL_MINUTES=10
# AUTONOMIZE_OTP_MAX_ATTEMPTS=5
# AUTONOMIZE_OTP_RESEND_COOLDOWN=60
# AUTONOMIZE_OTP_MAX_PER_HOUR=8

# ---------------------------------------------------------------------------
# Google OAuth — all three are required together
# ---------------------------------------------------------------------------

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID (type: Web application). The redirect URI must match EXACTLY,
# including scheme, port and trailing path — Google compares it as a string.
#
# AUTONOMIZE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# AUTONOMIZE_GOOGLE_CLIENT_SECRET=
# AUTONOMIZE_GOOGLE_REDIRECT_URI=https://api.your-college.edu/api/auth/google/callback

# Where the browser may be sent after a successful callback. EXACT matches
# only, comma-separated. An open redirect on an auth callback is the last
# hop of a phishing chain that starts on a domain the victim trusts, so a
# value that is not on this list is dropped rather than followed.
# AUTONOMIZE_OAUTH_REDIRECT_ALLOWLIST=https://dashboard.your-college.edu/
